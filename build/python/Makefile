# python build — the canonical shared Python (uv) toolchain Makefile.
#
# ┌───────────────────────────────────────────────────────────────────────────┐
# │ DO NOT EDIT THIS FILE IN A CONSUMER REPO.                                   │
# │                                                                            │
# │ This Makefile is DISTRIBUTED into every registered org's Python repos by    │
# │ distribute-build (sourced from                                              │
# │ nicerobot/tools.build/build/python). It is owned upstream — an in-tree edit │
# │ is OVERWRITTEN by the next push. It does NOT point outward (no self-update, │
# │ no network beyond uv): the canonical copy is pushed TO repos, never pulled. │
# │                                                                            │
# │   • Change shared behavior  -> edit nicerobot/tools.build/build/python,     │
# │     then re-run distribute-build.                                           │
# │   • Customize ONE repo       -> add a Makefile.local (see the tail of this  │
# │     file) and ADD new targets there — never redefine a target this file     │
# │     already declares.                                                      │
# └───────────────────────────────────────────────────────────────────────────┘
#
# Single source of truth for how every Python library and service runs
# format / lint / type-check / tests and builds distributions. A repo runs its
# own in-tree copy directly:
#
#   make lint test            # from inside any repo
#
# CI runs the same in-tree `ci` target (see nicerobot/tools.build/ci/python).
#
# Tools run via `uv run`, which resolves the version the CONSUMER pinned in its
# pyproject.toml dev dependencies (ruff, ty, pytest) and syncs the environment on
# first use — exactly how the Go Makefile defers tool versions to the consumer's
# go.mod. Nothing is installed globally; uv owns the project venv.

# A Self-Documenting Makefile: http://marmelab.com/blog/2016/02/29/auto-documented-makefile.html
.DEFAULT_GOAL := test

UV ?= uv
RUFF := $(UV) run ruff
TY   := $(UV) run ty
PYTEST := $(UV) run pytest

.PHONY: help
help: ## This help
	@awk 'BEGIN {FS = ":.*##"; printf "\nUsage:\n  make \033[36m[ target... ]\033[0m\n"} /^[a-zA-Z_0-9@\/ -]+:.*?##/ { printf "  \033[36m%-20s\033[0m %s\n", $$1, $$2 } /^##@/ { printf "\n\033[1m%s\033[0m\n", substr($$0, 5) } ' $(sort $(MAKEFILE_LIST))

##@ Setup

.PHONY: deps
deps: ## Sync the project environment from pyproject.toml + uv.lock
	$(UV) sync

##@ CI

# `ci` is the HARD CI gate — the single source of truth for what every push must
# pass. It mirrors `check` (format, lint, type-check, tests). The ci/python gate
# image runs exactly this target, so a local `check` predicts a green CI.
.PHONY: ci
ci: check ## Aggregate target for CI builds

##@ Code Quality

.PHONY: check
check: fmt-check lint typecheck test ## Full developer gate (CI runs this)

.PHONY: fmt
fmt: ## Format code (ruff format)
	$(RUFF) format

.PHONY: fmt-check
fmt-check: ## Verify formatting without rewriting
	$(RUFF) format --check

.PHONY: lint
lint: ## Lint (ruff check)
	$(RUFF) check

.PHONY: lint-fix
lint-fix: ## Lint and apply safe fixes
	$(RUFF) check --fix

.PHONY: typecheck
typecheck: ## Type-check (ty)
	$(TY) check

##@ Test

.PHONY: test
test: ## Run tests (pytest)
	$(PYTEST)

##@ Build

.PHONY: build
build: ## Build the wheel + sdist (uv build)
	$(UV) build

.PHONY: clean
clean: ## Clean build + tool caches
	rm -rf dist .pytest_cache .ruff_cache

# --------------------------------------------------------------------------- #
# Per-repo customization (optional, repo-owned — the ONLY place a repo diverges)
# --------------------------------------------------------------------------- #
# A repo customizes the toolchain WITHOUT editing this shared file by dropping a
# Makefile.local beside it. It is `-include`d here (the leading `-` makes it a
# silent no-op when absent), so it is read LAST: ADD new targets there. Never
# redefine a target this file already declares.
-include Makefile.local
