#!/bin/bash
# docs — Markdown lint + format + Mermaid render gate. Lints every tracked .md
# with the gomatic ruleset, then prettier --check (proseWrap:never) fails any doc
# that is not already formatted (e.g. hard-wrapped prose), then extracts each
# ```mermaid block and renders it so a diagram that no longer parses fails the
# build. Skips cleanly when a repo has no markdown.
set -o errexit
set -o nounset
set -o pipefail

readonly md_config=/etc/gomatic.markdownlint-cli2.jsonc
readonly prettier_config=/etc/gomatic.prettierrc.json
readonly puppeteer_config=/etc/puppeteer.json

# --- .standards.yaml declarations -------------------------------------------
#
# A gate a repo cannot satisfy leaves it permanently RED, which is worse than
# ungated: it trains everyone to ignore the colour, so the day it goes red for a
# real reason nobody looks. Deleting the workflow is not the fix either — that
# erases the fact that the gap exists. Instead the repo DECLARES the gap in
# .standards.yaml, the run reports green, and the declaration stays where
# `git repo standards verify` and the distribute ratchet already read it.
#
#   exempt:
#     "gate:docs": "reason"                    # skip this gate entirely
#     "gate:docs:paths": "skills/**,third/**"  # gate everything EXCEPT these
#
# Prefer the second: a repo vendoring third-party docs keeps its OWN markdown
# gated while someone else's stops failing a ruleset it was never written for.
#
# Parsed with sed because these images carry no yq/jq/python — hence the flat
# `key: value` shape. Keys contain a colon, so YAML requires them quoted; both
# quoted and bare forms are accepted.
standards_value() {
  local key="$1" file=.standards.yaml
  [[ -f "${file}" ]] || return 0
  # The key is matched WITH its quotes. A key containing a colon must be quoted
  # in YAML, and requiring them here is what stops 'gate:docs' from also
  # matching the 'gate:docs:paths' line — an optional-quote pattern does.
  sed -n -E "s/^[[:space:]]*\"${key}\"[[:space:]]*:[[:space:]]*(.*)$/\1/p" "${file}" |
    head -1 |
    sed -E 's/[[:space:]]+#.*$//; s/^"(.*)"$/\1/; s/[[:space:]]+$//'
}

exempt_reason="$(standards_value 'gate:docs')"
if [[ -n "${exempt_reason}" ]]; then
  echo "STANDARDS: 'gate:docs' exempt — ${exempt_reason}"
  echo 'Declared in .standards.yaml, so the gap stays visible to the standards verifier and the ratchet.'
  exit 0
fi

# A submodule's markdown belongs to the submodule's own repository, which gates
# it there. Once workflows check submodules out (submodules: recursive, which
# they must, or a dependent repo cannot build), the parent's docs gate starts
# linting its dependencies' READMEs and agent files and fails for their debt —
# www.adm.one carries pike and watchword, and reported five findings that were
# entirely watchword's.
#
# .gitmodules is parsed with awk rather than `git config --file`, because this
# image has no git: the git-based version in ci/typescript failed silently, its
# stderr going to /dev/null, and pruned nothing.
prune=()
if [ -f .gitmodules ]; then
  while IFS= read -r submodule; do
    test -n "${submodule}" || continue
    prune+=(-not -path "./${submodule}/*")
  done < <(awk -F'=' '/^[[:space:]]*path[[:space:]]*=/ {gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2}' .gitmodules)
fi

# CHANGELOG.md is release-please output — generated, so exempt from the gates
# like every generated artifact.
mapfile -t md_files < <(find . -name '*.md' -not -name 'CHANGELOG.md' \
  -not -path '*/vendor/*' -not -path '*/node_modules/*' \
  ${prune[@]+"${prune[@]}"} | sort)

# Declared exclusions, e.g. a tree of vendored third-party docs that were never
# written to this ruleset. The repo's OWN markdown stays gated.
while read -r glob; do
  [[ -n "${glob}" ]] || continue
  before=${#md_files[@]}
  mapfile -t md_files < <(printf '%s\n' "${md_files[@]}" | grep -v -- "$(printf '%s' "${glob}" | sed -E 's#\*\*/?#.*#g; s#^\./##')" || true)
  echo "STANDARDS: 'gate:docs:paths' excluded ${glob} ($((before - ${#md_files[@]})) file(s))"
  # printf '%s\n' — WITHOUT the newline `read` hits EOF on the final (often only)
  # entry and the loop body never runs, silently ignoring the declaration.
done < <(printf '%s\n' "$(standards_value 'gate:docs:paths')" | tr ',' '\n' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')

if [[ ${#md_files[@]} -eq 0 ]]; then
  echo 'no markdown files — skipping'
  exit 0
fi

# A repo may also disable specific RULES rather than whole files. That is the
# finest grain available and the one to prefer: excluding a path stops gating a
# document entirely, while disabling one rule keeps every other check on it.
#
#   exempt:
#     "gate:docs:rules": "MD025"   # e.g. a document of stacked top-level sections
#
# Implemented by extending the shared ruleset rather than replacing it, so the
# repo still inherits every rule it did not name.
active_md_config="${md_config}"
rules="$(standards_value 'gate:docs:rules')"
if [[ -n "${rules}" ]]; then
  # Built by INJECTING the disables into a copy of the shared ruleset, not by
  # `extends`: a generated config that re-declares "default" silently drops the
  # base file's own relaxations (MD013 off, MD033 off, ...) and the gate then
  # fails on rules nobody asked for. Copying keeps every inherited setting.
  active_md_config=/tmp/gomatic.markdownlint-cli2.jsonc
  disables=''
  while read -r rule; do
    [[ -n "${rule}" ]] || continue
    disables+="\"${rule}\": false, "
  done < <(printf '%s\n' "${rules}" | tr ',' '\n' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')
  sed -E "s/(\"config\"[[:space:]]*:[[:space:]]*\{)/\1 ${disables}/" "${md_config}" >"${active_md_config}"
  echo "STANDARDS: 'gate:docs:rules' disabled ${rules} (every other rule still applies)"
fi

echo '== markdownlint =='
markdownlint-cli2 --config "${active_md_config}" "${md_files[@]}"

echo '== prettier (prose-wrap) =='
prettier --config "${prettier_config}" --check "${md_files[@]}"

echo '== mermaid render =='
status=0
for md in "${md_files[@]}"; do
  rm -f /tmp/mmd-*.mmd
  # Split each fenced ```mermaid block into its own file so multiple diagrams in
  # one document are each validated independently.
  awk '
    /^```mermaid[[:space:]]*$/ { n++; fn = sprintf("/tmp/mmd-%03d.mmd", n); inblk = 1; next }
    /^```/ && inblk         { inblk = 0; next }
    inblk                   { print > fn }
  ' "${md}"
  for diagram in /tmp/mmd-*.mmd; do
    [[ -e "${diagram}" ]] || continue
    echo "rendering ${md} (${diagram##*/})"
    mmdc --puppeteerConfigFile "${puppeteer_config}" \
      --input "${diagram}" --output /tmp/diagram.svg || status=1
  done
done

exit "${status}"
