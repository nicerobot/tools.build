#!/bin/bash
# go — Go quality gate. Runs the shared build/go/Makefile `ci` target when the
# repo has first-party packages; otherwise just prints the pinned tool versions
# (the case for a repo that ships no packages of its own). The quality tools are
# baked into ${GOBIN} by the go-tooling base image, so no tool stanza or vendored
# tooling is needed and the gate resolves every tool from ${GOBIN}.
#
# The package probe below distinguishes "this repo has no packages" from
# "`go list` could not answer". Those are not the same, and conflating them makes
# the gate fail OPEN: a repo whose modules cannot resolve reports success having
# run nothing. That is exactly what happened to the repos depending on private
# first-party modules — the gate was green for months while checking nothing.
set -o errexit
set -o nounset
set -o pipefail

# A repo whose Go code embeds a generated tree cannot be listed until that tree
# exists: `//go:embed all:frontend/dist` fails on a fresh clone, and the probe
# below then reports "the package set is unknown" for a reason that has nothing
# to do with private modules. That is a false accusation, and it left every
# ui-class repo — the template included — permanently red.
#
# A repo declares that setup as `ci-prepare` and it runs FIRST. It must not need
# anything outside this image: there is no Node here, and adding one for a
# single class would put a frontend toolchain in the path of every Go repo. The
# target's job is to make the embed RESOLVE, not to produce real assets — the
# gate lints, vets and tests Go, none of which reads them. Real assets are still
# built locally and for releases.
#
# Repos without the target are unaffected: `make -n` fails and nothing runs.
if make -n ci-prepare >/dev/null 2>&1; then
  echo "running ci-prepare (repo declares generated sources the package probe needs)"
  make ci-prepare
fi

# A repo can be a MULTI-MODULE aggregate: no go.mod at the ROOT, one per
# example or sub-tool beneath it. `go list ./...` cannot answer there — it
# reports "directory prefix . does not contain main module" — so the probe below
# would call the package set unknown and fail a repo that is perfectly
# well-formed. gloo-foo/examples is the case: eight modules, no root module.
#
# Such a repo owns its own aggregate Makefile that recurses into each module,
# declared as `artifact:makefile` in .standards.yaml so distribute does not
# clobber it. The gate's job here is to RUN that aggregate, not to second-guess
# it. (gloo-foo/examples had already noticed the gap and aliased tools-version
# to its own gate, reaching for the no-packages fallback below — which never
# fired, because the probe errors rather than returning empty.)
#
# This stays fail-CLOSED: a multi-module repo with no aggregate target is an
# error, exactly like an unanswerable probe, never a skip.
# vendor/ and testdata/ are excluded for the same reason the package list below
# filters vendor: a module inside either is not one of the repo's own, and
# treating a vendored go.mod as evidence of a multi-module layout would route a
# repo into the aggregate branch on someone else's file.
multi_module_probe() {
  find . -name go.mod -not -path './.*' -not -path '*/vendor/*' -not -path '*/testdata/*' -print -quit
}

if [[ ! -f go.mod ]] && [[ -n "$(multi_module_probe)" ]]; then
  # The aggregate is run ONLY when the repo has declared that it owns its build,
  # via the artifact:makefile exemption. That declaration is the difference
  # between gloo-foo/examples — whose Makefile recurses into each module — and a
  # repo carrying the SHARED single-module Makefile with one module in a
  # subdirectory (nicerobot.github.io, whose only Go is ./year). Running `make
  # ci` in the second case just fails further in, having still checked nothing,
  # and hides a layout question behind a build error. That one falls through to
  # the probe below, whose message already says what to do.
  if [[ -f .standards.yaml ]] && grep -q 'artifact:makefile' .standards.yaml; then
    for target in ci check; do
      if make -n "${target}" >/dev/null 2>&1; then
        echo "multi-module repo (no root go.mod) — running the repo's own aggregate '${target}'"
        exec make "${target}"
      fi
    done
  fi
  cat >&2 <<'EOF'

gate: this repo has Go modules BENEATH it but none at the root.

Refusing to report success: `go list ./...` cannot enumerate packages from a
directory that is not itself a module, so nothing here has been checked. This
is an error, never a skip.

Two shapes end differently.

  A multi-module aggregate (many example or tool modules, no root module). It
  owns an aggregate Makefile that recurses into each one, and declares that in
  .standards.yaml so distribute does not clobber it:

      exempt:
        artifact:makefile: "<why this repo's build is its own>"

  With that declared, this gate runs the repo's own `ci` (or `check`) target.

  A repo whose Go lives in ONE subdirectory while the root is something else (a
  site, a dataset). Nothing here can guess which subtree is the module, and
  pointing the shared gate at the root checks nothing. Either move the module to
  the root, or drop the workflow:

      exempt:
        artifact:workflow:go: "<module> lives in <dir>; gated there"
EOF
  exit 1
fi

probe_err="$(mktemp)"
trap 'rm -f "${probe_err}"' EXIT

if ! pkgs="$(go list ./... 2>"${probe_err}")"; then
  cat "${probe_err}" >&2
  cat >&2 <<'EOF'

gate: `go list ./...` failed, so the package set is unknown.

Refusing to report success: a gate that cannot enumerate the repo's packages has
not checked anything. This is an error, never a skip.

If the failure names a first-party module, that module is private. The gate runs
with no credentials by design: wiring private access into every consumer spreads
one library's access rules across the whole fleet, and gates the repo on a secret
existing rather than on its code being sound.

A module is private for one of two reasons, and they end differently.

  Private until it is good enough. The exit is to bring the library up to
  standard — immutable types, clean interfaces, full coverage with the failure
  paths asserted, the gate green — and publish it. The exemption below is
  temporary and comes off when it does.

  Private on purpose, because the interface itself is the intellectual property.
  It is never published, so its consumers are never gated here. That is a
  deliberate trade, not a defect: their quality bar is enforced by `make check`
  run locally, and CI covers only what can be built without secrets.

Either way this repo must not carry a workflow it cannot satisfy. Declare it in
.standards.yaml and let `distribute` drop the workflow:

    exempt:
      artifact:workflow:go: "<module> is private; gated locally via make check"

State which of the two cases applies in the reason, so a permanent exemption is
never mistaken for a backlog item.
EOF
  exit 1
fi

pkgs="$(printf '%s\n' "${pkgs}" | grep -v /vendor/ || true)"
if [[ -n "${pkgs}" ]]; then
  exec make ci
fi

# `go list` succeeded and matched nothing: the repo genuinely ships no packages.
# Print the pinned tool versions from ${GOBIN} as a smoke test that the baked
# toolchain is present — WITHOUT the go.mod mutation that `make tools` does
# (which must never touch a mounted working tree).
echo "no first-party packages — reporting the pinned tool versions from \${GOBIN}"
exec make tools-version
