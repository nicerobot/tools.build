{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "preset": "all"
      },
      "complexity": {
        "preset": "all",
        "noExcessiveLinesPerFunction": "off"
      },
      "correctness": {
        "preset": "all",
        "useImportExtensions": "off"
      },
      "performance": {
        "preset": "all"
      },
      "security": {
        "preset": "all",
        "noSecrets": {
          "level": "error",
          "options": {
            "entropyThreshold": 45
          }
        }
      },
      "suspicious": {
        "preset": "all"
      },
      "style": {
        "preset": "all",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": {
                  "kind": "typeProperty"
                },
                "formats": [
                  "camelCase",
                  "snake_case",
                  "PascalCase",
                  "CONSTANT_CASE"
                ]
              },
              {
                "selector": {
                  "kind": "objectLiteralMember"
                },
                "formats": [
                  "camelCase",
                  "snake_case",
                  "PascalCase",
                  "CONSTANT_CASE"
                ]
              }
            ]
          }
        },
        "noTernary": "off",
        "noNestedTernary": "error",
        "useExportsLast": "off",
        "noExcessiveLinesPerFile": "off"
      }
    },
    "domains": {
      "types": "all",
      "project": "all",
      "test": "all",
      "react": "none",
      "reactNative": "none",
      "solid": "none",
      "next": "none",
      "qwik": "none",
      "svelte": "none",
      "vue": "none",
      "drizzle": "none",
      "tailwind": "none",
      "turborepo": "none",
      "playwright": "none"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab",
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/src/index.ts",
        "**/src/index.tsx",
        "**/worker.ts",
        "**/*.config.ts",
        "**/*.config.js",
        "**/*.config.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
            "noMagicNumbers": "off"
          },
          "performance": {
            "noBarrelFile": "off",
            "noReExportAll": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/build.mjs",
        "**/build.js",
        "**/scripts/**",
        "**/tools/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noUnresolvedImports": "off"
          },
          "suspicious": {
            "noConsole": "off"
          },
          "performance": {
            "noAwaitInLoops": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.spec.ts",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/e2e/**",
        "**/test/**",
        "**/tests/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off",
            "noProcessEnv": "off",
            "noExcessiveLinesPerFile": "off",
            "noExportedImports": "off",
            "noDefaultExport": "off"
          },
          "correctness": {
            "noNodejsModules": "off",
            "noUnresolvedImports": "off"
          },
          "performance": {
            "useTopLevelRegex": "off",
            "noAwaitInLoops": "off",
            "noBarrelFile": "off",
            "noReExportAll": "off"
          },
          "complexity": {
            "noExcessiveLinesPerFunction": "off",
            "noRedundantDefaultExport": "off"
          },
          "suspicious": {
            "useAwait": "off"
          },
          "security": {
            "noSecrets": {
              "level": "error",
              "options": {
                "entropyThreshold": 100
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/*.d.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noNamespace": "off"
          }
        }
      }
    }
  ]
}
