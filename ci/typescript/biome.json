{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "preset": "all"
      },
      "complexity": {
        "preset": "all"
      },
      "correctness": {
        "preset": "all"
      },
      "performance": {
        "preset": "all"
      },
      "security": {
        "preset": "all"
      },
      "suspicious": {
        "preset": "all"
      },
      "style": {
        "preset": "all",
        "noDefaultExport": "off",
        "noMagicNumbers": "off",
        "useNamingConvention": "off"
      }
    },
    "domains": {
      "types": "all",
      "project": "all",
      "test": "all",
      "react": "none",
      "reactNative": "none",
      "solid": "none",
      "next": "none",
      "qwik": "none",
      "svelte": "none",
      "vue": "none",
      "drizzle": "none",
      "tailwind": "none",
      "turborepo": "none",
      "playwright": "none"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab",
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
