{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "preset": "all"
      },
      "complexity": {
        "preset": "all"
      },
      "correctness": {
        "preset": "all"
      },
      "performance": {
        "preset": "all"
      },
      "security": {
        "preset": "all"
      },
      "suspicious": {
        "preset": "all"
      },
      "style": {
        "preset": "all",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": true,
            "conventions": [
              {
                "selector": {
                  "kind": "typeProperty"
                },
                "formats": [
                  "camelCase",
                  "snake_case"
                ]
              },
              {
                "selector": {
                  "kind": "objectLiteralMember"
                },
                "formats": [
                  "camelCase",
                  "snake_case"
                ]
              }
            ]
          }
        }
      }
    },
    "domains": {
      "types": "all",
      "project": "all",
      "test": "all",
      "react": "none",
      "reactNative": "none",
      "solid": "none",
      "next": "none",
      "qwik": "none",
      "svelte": "none",
      "vue": "none",
      "drizzle": "none",
      "tailwind": "none",
      "turborepo": "none",
      "playwright": "none"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab",
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/src/index.ts",
        "**/src/index.tsx",
        "**/worker.ts",
        "**/*.config.ts",
        "**/*.config.js",
        "**/*.config.mjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/tests/**",
        "**/test/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off"
          }
        }
      }
    }
  ]
}
