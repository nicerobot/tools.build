#!/bin/bash
# typescript — Biome lint + format check for JS/TS. Skips cleanly when a repo has
# no JavaScript/TypeScript. Committed build artifacts and generated code are
# excluded, mirroring the Go gate: minified bundles (*.min.js, *.bundle.js) and
# files carrying a generated marker (ANTLR parsers, `Code generated`,
# `@generated`) are regenerated from their source, never linted.
#
# coverage/ is excluded for the same reason. istanbul writes a report bundling
# its own sorter.js/prettify.js/block-navigation.js, which carry no generated
# marker and trip a dozen rules apiece. CI never sees them — the directory is
# gitignored and a fresh checkout omits it — so including them only breaks the
# local run, and does so with ~50 findings that look like real debt.
set -o errexit
set -o nounset
set -o pipefail

mapfile -t candidates < <(find . -type f \
  \( -name '*.ts' -o -name '*.tsx' -o -name '*.js' -o -name '*.jsx' \
  -o -name '*.mjs' -o -name '*.cjs' \) \
  -not -path '*/vendor/*' -not -path '*/node_modules/*' -not -path '*/dist/*' \
  -not -path './public/*' -not -path '*/coverage/*' \
  -not -name '*.min.js' -not -name '*.bundle.js' | sort)

files=()
if [[ ${#candidates[@]} -gt 0 ]]; then
  for f in "${candidates[@]}"; do
    if head -n3 "${f}" | grep -qE 'Generated from .* by ANTLR|Code generated .* DO NOT EDIT|@generated'; then
      continue
    fi
    files+=("${f}")
  done
fi

if [[ ${#files[@]} -eq 0 ]]; then
  echo 'no javascript/typescript files — skipping'
  exit 0
fi

# The baked ruleset is COPIED INTO the workspace rather than passed with
# --config-path, because --config-path also tells Biome where the project root
# is: pointed at /etc, every rule in the `project` domain reports "cannot be
# verified because no package.json file was found" and noUndeclaredDependencies
# becomes two false failures per repo. Copied in, the root is the repo and those
# rules work.
#
# It overwrites a repository's own biome.json for the duration, which is the
# intent: the fleet ruleset is not negotiable per repo, and a repo that could
# drop a laxer config beside its source could opt out of the gate silently. The
# copy is removed again on exit, whatever the outcome, so a local run against a
# real working tree leaves nothing behind.
# Dependencies are installed before linting, when the repo has a lockfile.
#
# Without them the strongest rules are inert or actively wrong: the `types`
# domain has no types to infer from, and noUnresolvedImports reports every
# third-party import as unresolved — 54 false failures in one repo, which
# disappear entirely once node_modules exists. A gate that cannot resolve an
# import is not checking the code, it is checking the checkout.
if [ -f package-lock.json ]; then
  echo '== npm ci =='
  npm ci --no-audit --no-fund
fi

readonly gate_config=biome.json
readonly saved_config=.biome.json.gate-backup
if [ -f "${gate_config}" ]; then
  mv "${gate_config}" "${saved_config}"
fi
restore_config() {
  rm -f "${gate_config}"
  if [ -f "${saved_config}" ]; then
    mv "${saved_config}" "${gate_config}"
  fi
}
trap restore_config EXIT INT TERM HUP
cp /etc/gomatic.biome.json "${gate_config}"

# --error-on-warnings because a warning that never fails anything is not a
# standard, it is a suggestion. selfmux carried 113 of them at once while its
# gate reported success on the strength of zero errors.
echo '== biome ci =='
biome ci --error-on-warnings "${files[@]}"
