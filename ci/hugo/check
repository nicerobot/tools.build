#!/bin/sh
# hugo — build every Hugo site in the repo (extended Hugo) so a site that no
# longer compiles fails before it reaches GitHub Pages. POSIX sh so the alpine
# base needs nothing added. Skips cleanly when there is no Hugo site.
set -eu

# A Hugo site root is a directory holding a Hugo config. Match modern (hugo.*)
# config names; ignore themes and dependency trees (they carry their own config).
find_roots() {
  find . \( -path './.git/*' -o -path './.github/*' -o -path '*/themes/*' \
    -o -path '*/node_modules/*' -o -path '*/vendor/*' \) -prune -o \
    -type f \( -name 'hugo.toml' -o -name 'hugo.yaml' -o -name 'hugo.yml' -o -name 'hugo.json' \) -print |
    sed 's#/[^/]*$##' | sort -u
}

if [ -z "$(find_roots)" ]; then
  echo 'no hugo sites — skipping'
  exit 0
fi

find_roots | while IFS= read -r root; do
  echo "== hugo build: ${root} =="
  hugo --gc --minify --source "${root}" --destination /tmp/hugo-out
done
